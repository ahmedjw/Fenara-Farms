# ---------------------------------------------------------------
# Database. Required: adoptions are stored in Postgres and checkout
# refuses to take a payment it cannot record.
#
# Anything that speaks Postgres works. On Replit, add the built-in
# database and it sets this for you. Neon and Supabase hand you a
# connection string to paste here. The schema is created on first use.
#
#   postgresql://user:password@host:5432/dbname?sslmode=require
#
# TLS is on for any non-local host, without verifying the certificate,
# which is what these providers' connection strings assume. Set
# PGSSLMODE=verify-full to verify, or PGSSLMODE=disable for a local
# server without TLS.
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Stripe. Get these from https://dashboard.stripe.com/test/apikeys
# Copy this file to .env.local and paste your keys in.
# ---------------------------------------------------------------

# Secret key. Starts with sk_test_ (test mode) or sk_live_ (live mode).
STRIPE_SECRET_KEY=

# Publishable key. Starts with pk_test_ or pk_live_. Not required: checkout
# runs on the server and the browser only follows the url Stripe returns.
# Kept here for a future Stripe.js integration.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret. Starts with whsec_
# Local:      stripe listen --forward-to localhost:3000/api/stripe/webhook
# Production: Stripe Dashboard > Developers > Webhooks > add endpoint
#             https://yourdomain.com/api/stripe/webhook
#             Events to listen for: checkout.session.completed,
#             checkout.session.expired, invoice.paid,
#             customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Customer portal login link, where adopters manage or cancel their yearly
# renewal. Stripe Dashboard > Settings > Billing > Customer portal: allow
# customers to cancel subscriptions "at the end of the billing period", save,
# then copy the login link (https://billing.stripe.com/p/login/...).
# Without it, the account page tells adopters to email you to cancel.
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# Public base URL, used for page metadata and the Stripe success and cancel
# redirects. Include the scheme, e.g. https://fenarafarms.com
#
# On Vercel and on Replit you can leave this unset: the deployment's own
# domain is used. Either remove the variable or give it a real value. Do not
# leave it defined but blank.
#
# NEXT_PUBLIC_ variables are baked into the build, not read when the site
# runs, so setting this after a build has no effect until you build again.
# That is why nothing else here needs the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
